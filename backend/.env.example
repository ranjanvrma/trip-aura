# ---- Data mode -------------------------------------------------------------
# "open"  -> any city worldwide from open data (Overture Maps, Wikidata, OpenStreetMap,
#            Wikivoyage, Nominatim). No API key needed. Adds Google ratings if a key is set.
# "live"  -> Google Maps Platform for everything (Places API (New), Routes API, Geocoding API).
# "mock"  -> bundled Jaipur demo dataset for offline testing; labelled data_source="mock".
# Failed requests are reported as errors/warnings; they are NEVER silently replaced with mock data.
DATA_MODE=open

# ---- Google Maps Platform (server-side key, optional in open mode) ---------
GOOGLE_MAPS_API_KEY=
GOOGLE_ENRICHMENT=true
GOOGLE_HTTP_TIMEOUT_SECONDS=10

# ---- Open data ---------------------------------------------------------------
# Wikimedia and OSM require a contact URL or email in the User-Agent (HTTP 403 otherwise).
OPEN_USER_AGENT=TripAura/0.1 (+https://github.com/ranjanvrma/trip-aura)
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# OSM_TIME_BUDGET_SECONDS=90
OVERTURE_ENABLED=true
# OVERTURE_RELEASE=          (empty = latest release from the Overture STAC catalog)
WIKIVOYAGE_ENABLED=true
CITY_CACHE_DAYS=30
# FX_URL=https://api.frankfurter.dev/v1/latest

# Routing: "heuristic" (distance x speed estimates) or "osrm" (road routes from OSRM servers)
ROUTING_ENGINE=heuristic
# OSRM_DRIVING_URL=https://router.project-osrm.org/route/v1/driving
# OSRM_WALKING_URL=https://routing.openstreetmap.de/routed-foot/route/v1/foot

# ---- Optional AI explanations (Anthropic) ----------------------------------
# Leave empty to disable. The itinerary/recommendation engines never depend on it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_ENABLED=false

# ---- App -------------------------------------------------------------------
# Default: backend/tripaura.db
# DATABASE_URL=sqlite:///D:/path/to/tripaura.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
