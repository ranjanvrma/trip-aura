# ---- Data mode -------------------------------------------------------------
# "mock"  -> bundled demo dataset (Jaipur), deterministic route estimates.
#            Every result is labelled data_source="mock". No API keys needed.
# "live"  -> Google Maps Platform (Places API (New), Routes API, Geocoding API).
#            Requires GOOGLE_MAPS_API_KEY. Failed live requests return errors;
#            they are NEVER silently replaced with mock data.
DATA_MODE=mock

# ---- Google Maps Platform (server-side key) --------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_HTTP_TIMEOUT_SECONDS=10

# ---- Optional AI explanations (Anthropic) ----------------------------------
# Leave empty to disable. The itinerary/recommendation engines never depend on it.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_ENABLED=false

# ---- App -------------------------------------------------------------------
# Default: backend/tripaura.db
# DATABASE_URL=sqlite:///D:/path/to/tripaura.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
