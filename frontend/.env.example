# Backend base URL.
#   Local dev: leave empty to use the Vite proxy (/api -> http://127.0.0.1:8000).
#   Production (Vercel): your backend URL, e.g. https://<hf-username>-trip-aura-api.hf.space
VITE_API_BASE_URL=

# Optional: browser key for the Maps JavaScript API (restrict it by HTTP referrer).
# When empty, the map uses Leaflet + OpenStreetMap tiles instead.
VITE_GOOGLE_MAPS_API_KEY=
