# Copy to deploy/oracle/.env on the server (setup.sh does this) and fill in.
# Never commit the real .env.

# Public hostname for the API. With no domain, use your VM's public IP via sslip.io:
#   IP 129.146.10.20  ->  API_DOMAIN=129-146-10-20.sslip.io
API_DOMAIN=

# Neon connection string (Neon dashboard -> Connect). Leave empty to use SQLite on the VM.
DATABASE_URL=

# Your Vercel URL(s), comma-separated, no trailing slash
CORS_ORIGINS=https://trip-aura.vercel.app
# Optional: allow Vercel preview deployments
CORS_ORIGIN_REGEX=https://trip-aura-.*\.vercel\.app

DATA_MODE=open
OPEN_USER_AGENT=TripAura/1.0 (+https://github.com/ranjanvrma/trip-aura)

# The VM has 12 GB RAM, so DuckDB can use more memory than on small hosts
DUCKDB_MEMORY_LIMIT=1GB
DUCKDB_THREADS=2

# Optional extras
GOOGLE_MAPS_API_KEY=
AI_ENABLED=false
ANTHROPIC_API_KEY=
LOG_LEVEL=INFO
